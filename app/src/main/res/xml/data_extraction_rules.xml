<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="calcmot_finance.db" />
        <exclude domain="database" path="calcmot_finance.db-wal" />
        <exclude domain="database" path="calcmot_finance.db-shm" />
        <exclude domain="sharedpref" path="calcmot_finance.xml" />
        <exclude domain="sharedpref" path="calcmot_finance_settings.xml" />
        <exclude domain="sharedpref" path="calcmot_metrics_research.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="calcmot_finance.db" />
        <exclude domain="database" path="calcmot_finance.db-wal" />
        <exclude domain="database" path="calcmot_finance.db-shm" />
        <exclude domain="sharedpref" path="calcmot_finance.xml" />
        <exclude domain="sharedpref" path="calcmot_finance_settings.xml" />
        <exclude domain="sharedpref" path="calcmot_metrics_research.xml" />
    </device-transfer>
</data-extraction-rules>
