// Approved DEV targets deployed2026-10-20. Model only; real owner UID is a remote secret.
{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"calcmot-admin-gateway-dev",
  "account_id":"45086fe60ce934025fcac45e65eb4b69",
  "main":"src/admin/gateway.ts",
  "compatibility_date":"2026-07-01",
  "workers_dev":false,"preview_urls":false,
  "routes":[
    {"pattern":"https://calcmot.com.br/api/admin/v1","zone_name":"calcmot.com.br"},
    {"pattern":"https://calcmot.com.br/api/admin/v1/*","zone_name":"calcmot.com.br"}
  ],
  "observability":{"enabled":false},
  "vars":{"FIREBASE_PROJECT_ID":"calcmot","ADMIN_ORIGIN":"https://calcmot.com.br",
    "ADMIN_REQUESTS_PER_MINUTE":"120","ADMIN_MUTATIONS_PER_MINUTE":"10"},
  "services":[{"binding":"ADMIN","service":"calcmot-admin-private-dev"}]
}
