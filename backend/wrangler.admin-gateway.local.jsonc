{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"calcmot-admin-gateway-local",
  "main":"src/admin/gateway.ts",
  "compatibility_date":"2026-07-01",
  "workers_dev":false,"preview_urls":false,"routes":[],
  "observability":{"enabled":false},
  "vars":{"FIREBASE_PROJECT_ID":"calcmot","ADMIN_ORIGIN":"http://127.0.0.1:8790",
    "ADMIN_REQUESTS_PER_MINUTE":"120","ADMIN_MUTATIONS_PER_MINUTE":"10"},
  "services":[{"binding":"ADMIN","service":"calcmot-admin-private-local"}]
}
