{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"calcmot-admin-private-local",
  "main":"src/admin/worker.ts",
  "compatibility_date":"2026-07-01",
  "workers_dev":false,"preview_urls":false,"routes":[],
  "observability":{"enabled":false},
  "vars":{"FIREBASE_PROJECT_ID":"calcmot","ADMIN_ORIGIN":"http://127.0.0.1:8790",
    "ADMIN_REQUESTS_PER_MINUTE":"120","ADMIN_MUTATIONS_PER_MINUTE":"10"},
  "d1_databases":[{"binding":"DB","database_name":"calcmot-admin-local",
    "database_id":"00000000-0000-0000-0000-000000000009","migrations_dir":"migrations"}]
}
