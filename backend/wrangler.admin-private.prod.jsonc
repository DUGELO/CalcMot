// Operational PROD configuration. Owner UID remains an existing Cloudflare secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calcmot-admin-private-prod",
  "account_id": "45086fe60ce934025fcac45e65eb4b69",
  "main": "src/admin/worker.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {"enabled": false},
  "vars": {
    "FIREBASE_PROJECT_ID": "calcmot",
    "ADMIN_ORIGIN": "https://calcmot.com.br",
    "ADMIN_ENVIRONMENT": "PROD",
    "ADMIN_MUTATIONS_ENABLED": "true",
    "ADMIN_REQUESTS_PER_MINUTE": "120",
    "ADMIN_MUTATIONS_PER_MINUTE": "10"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "calcmot-identity-prod",
    "database_id": "d0232771-b6e7-49a1-ae9f-05267fbdf3a1",
    "migrations_dir": "migrations"
  }]
}
