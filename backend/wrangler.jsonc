{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calcmot-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "vars": { "FIREBASE_PROJECT_ID": "calcmot" },
  "d1_databases": [{ "binding": "DB", "database_name": "calcmot-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }]
}
